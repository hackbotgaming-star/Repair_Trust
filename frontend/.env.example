# RepairTrust Frontend Environment Configuration Example
# Vite dev server proxies /api and /uploads to the backend server automatically

VITE_API_BASE_URL=/api
VITE_UPLOADS_BASE_URL=/uploads
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
